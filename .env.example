# Example environment variables for backend
# PostgreSQL is the default database. Set MRN_DATABASE_URL to the PostgreSQL connection string.

# Optional. Defaults to 'postgres'. Set to 'sqlite' only for the legacy local fallback.
MRN_DB_DRIVER=postgres

# Neon / PostgreSQL connection URL (example format):
# postgres://user:password@ep-some-host.neon.tech:5432/neondb
MRN_DATABASE_URL=

# Alternative name supported by many hosting providers.
DATABASE_URL=

# Optional. Use disable only for local PostgreSQL servers without SSL.
# PGSSLMODE=require

# Other common variables used by the app
PORT=4000
NODE_ENV=development
JWT_SECRET=dev_jwt_secret
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change_me

# Optional for local PDF export when Puppeteer has no bundled browser.
# Windows Chrome example:
# PUPPETEER_EXECUTABLE_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"
#
# Render production:
# Do not set PUPPETEER_EXECUTABLE_PATH to a local machine path.
# The backend postinstall script installs Puppeteer Chrome into backend/.cache/puppeteer.
PUPPETEER_CACHE_DIR=./.cache/puppeteer
PUPPETEER_SKIP_DOWNLOAD=false

# PDF font export
# The PDF backend must have Trebuchet MS available to preserve the required export font.
# Preferred: place the font files in backend/assets/fonts:
#   trebuc.ttf, trebucbd.ttf, trebucit.ttf, trebucbi.ttf
# Or set explicit paths:
# TREBUCHET_MS_REGULAR_PATH=
# TREBUCHET_MS_BOLD_PATH=
# TREBUCHET_MS_ITALIC_PATH=
# TREBUCHET_MS_BOLD_ITALIC_PATH=
PDF_REQUIRE_TREBUCHET_MS=true
