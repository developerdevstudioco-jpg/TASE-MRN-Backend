# Example environment variables for backend
# Use MRN_DB_DRIVER=postgres and set MRN_DATABASE_URL to the Neon/PG connection string

# Set to 'postgres' to enable Neon/Postgres driver. Defaults to 'sqlite'.
MRN_DB_DRIVER=postgres

# Neon / Postgres connection URL (example format):
# postgres://user:password@ep-some-host.neon.tech:5432/neondb
MRN_DATABASE_URL=

# Other common variables used by the app
PORT=4000
NODE_ENV=development
JWT_SECRET=dev_jwt_secret
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change_me
